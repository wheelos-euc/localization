module_config {
  module_library: "/apollo/bazel-bin/external/wheelos_localization+/modules/localization/liblocalization_component.so"
  timer_components {
    class_name: "OpenLocLocalizationComponent"
    config {
      name: "openloc_localization"
      config_file_path: "/apollo/pkgs/localization/modules/localization/conf/localization.pb.txt"
      interval: 10
    }
  }
}
