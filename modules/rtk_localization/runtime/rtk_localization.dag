module_config {
  module_library: "lib/components/rtk_localization/librtk_localization_component.so"
  components {
    class_name: "RTKLocalizationComponent"
    config {
      name: "rtk_localization"
      config_file_path: "conf/rtk_localization/rtk_localization.pb.txt"
      readers: [
        {
          channel: "/apollo/sensor/gnss/odometry"
          qos_profile: {
            depth: 10
          }
          pending_queue_size: 50
        }
      ]
    }
  }
}
